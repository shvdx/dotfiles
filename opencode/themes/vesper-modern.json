{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg_dark": "#101010",
    "bg_light": "#FAFAFA",
    "panel_bg_dark": "#232323",
    "panel_bg_light": "#DEDEDE",
    "element_bg_dark": "#1a1a1a",
    "element_bg_light": "#EDEDED",
    "fg_dark": "#FFFFFF",
    "fg_light": "#1A1A1A",
    "fg_muted_dark": "#A0A0A0",
    "fg_muted_light": "#5C5C5C",
    "fg_dim_dark": "#505050",
    "fg_dim_light": "#8A8A8A",
    "orange_dark": "#FFC799",
    "orange_light": "#C47A4A",
    "teal_dark": "#66DDCC",
    "teal_light": "#1A8A6A",
    "teal_dim_dark": "#99FFE4",
    "teal_dim_light": "#3A7A6A",
    "blue_dark": "#9CC1FF",
    "blue_light": "#4A6AC4",
    "purple_dark": "#C7A9FF",
    "purple_light": "#7A5AC4",
    "red_dark": "#FF8080",
    "red_light": "#CC4444",
    "gray_dark": "#A0A0A0",
    "gray_light": "#5C5C5C",
    "border_dark": "#282828",
    "border_light": "#C0C0C0",
    "diff_add_bg_dark": "#102e2a",
    "diff_add_bg_light": "#dff0ea",
    "diff_del_bg_dark": "#3a1f1f",
    "diff_del_bg_light": "#f5dede"
  },
  "theme": {
    "primary": { "dark": "orange_dark", "light": "orange_light" },
    "secondary": { "dark": "teal_dark", "light": "teal_light" },
    "accent": { "dark": "teal_dark", "light": "teal_light" },
    "error": { "dark": "red_dark", "light": "red_light" },
    "warning": { "dark": "orange_dark", "light": "orange_light" },
    "success": { "dark": "teal_dark", "light": "teal_light" },
    "info": { "dark": "teal_dark", "light": "teal_light" },
    "text": { "dark": "fg_dark", "light": "fg_light" },
    "textMuted": { "dark": "fg_muted_dark", "light": "fg_muted_light" },
    "background": { "dark": "bg_dark", "light": "bg_light" },
    "backgroundPanel": { "dark": "panel_bg_dark", "light": "panel_bg_light" },
    "backgroundElement": { "dark": "element_bg_dark", "light": "element_bg_light" },
    "border": { "dark": "border_dark", "light": "border_light" },
    "borderActive": { "dark": "orange_dark", "light": "orange_light" },
    "borderSubtle": { "dark": "border_dark", "light": "border_light" },
    "diffAdded": { "dark": "teal_dark", "light": "teal_light" },
    "diffRemoved": { "dark": "red_dark", "light": "red_light" },
    "diffContext": { "dark": "fg_dim_dark", "light": "fg_dim_light" },
    "diffHunkHeader": { "dark": "orange_dark", "light": "orange_light" },
    "diffHighlightAdded": { "dark": "teal_dark", "light": "teal_light" },
    "diffHighlightRemoved": { "dark": "red_dark", "light": "red_light" },
    "diffAddedBg": { "dark": "diff_add_bg_dark", "light": "diff_add_bg_light" },
    "diffRemovedBg": { "dark": "diff_del_bg_dark", "light": "diff_del_bg_light" },
    "diffContextBg": { "dark": "panel_bg_dark", "light": "panel_bg_light" },
    "diffLineNumber": { "dark": "fg_muted_dark", "light": "fg_muted_light" },
    "diffAddedLineNumberBg": { "dark": "diff_add_bg_dark", "light": "diff_add_bg_light" },
    "diffRemovedLineNumberBg": { "dark": "diff_del_bg_dark", "light": "diff_del_bg_light" },
    "markdownText": { "dark": "fg_dark", "light": "fg_light" },
    "markdownHeading": { "dark": "orange_dark", "light": "orange_light" },
    "markdownLink": { "dark": "teal_dark", "light": "teal_light" },
    "markdownLinkText": { "dark": "teal_dim_dark", "light": "teal_dim_light" },
    "markdownCode": { "dark": "teal_dark", "light": "teal_light" },
    "markdownBlockQuote": { "dark": "fg_dim_dark", "light": "fg_dim_light" },
    "markdownEmph": { "dark": "orange_dark", "light": "orange_light" },
    "markdownStrong": { "dark": "orange_dark", "light": "orange_light" },
    "markdownHorizontalRule": { "dark": "fg_dim_dark", "light": "fg_dim_light" },
    "markdownListItem": { "dark": "orange_dark", "light": "orange_light" },
    "markdownListEnumeration": { "dark": "teal_dim_dark", "light": "teal_dim_light" },
    "markdownImage": { "dark": "teal_dark", "light": "teal_light" },
    "markdownImageText": { "dark": "teal_dim_dark", "light": "teal_dim_light" },
    "markdownCodeBlock": { "dark": "fg_dark", "light": "fg_light" },
    "syntaxComment": { "dark": "fg_dim_dark", "light": "fg_dim_light" },
    "syntaxKeyword": { "dark": "purple_dark", "light": "purple_light" },
    "syntaxFunction": { "dark": "teal_dark", "light": "teal_light" },
    "syntaxVariable": { "dark": "teal_dim_dark", "light": "teal_dim_light" },
    "syntaxString": { "dark": "teal_dark", "light": "teal_light" },
    "syntaxNumber": { "dark": "teal_dim_dark", "light": "teal_dim_light" },
    "syntaxType": { "dark": "blue_dark", "light": "blue_light" },
    "syntaxOperator": { "dark": "orange_dark", "light": "orange_light" },
    "syntaxPunctuation": { "dark": "fg_dark", "light": "fg_light" }
  }
}
